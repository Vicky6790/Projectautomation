# Local MVP: auth is disabled. Set AUTH_MODE=required for on-prem multi-user.
AUTH_MODE=disabled
OPENAI_API_KEY=
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
# Ceiling used by storage; per-type limits are SOW 25 MB and MPP 50 MB (WO-24).
MAX_UPLOAD_BYTES=52428800
# Request handles survive container restarts on DATA_DIR and expire after this idle period.
REQUEST_TTL_HOURS=24
