# Local MVP: auth is disabled. On-prem Compose defaults AUTH_MODE=required.
AUTH_MODE=disabled
AUTH_BOOTSTRAP_USER=admin
AUTH_BOOTSTRAP_PASSWORD=
SESSION_IDLE_HOURS=8
OPENAI_API_KEY=
# Optional. Set to Azure OpenAI or an on-prem compatible endpoint for sensitive engagements.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Local Compose defaults to stub analysis so E2E can run without a provider key.
AI_STUB=true
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
# Ceiling used by storage; per-type limits are SOW 25 MB and MPP 50 MB (WO-24).
MAX_UPLOAD_BYTES=52428800
# Request handles survive container restarts on DATA_DIR and expire after this idle period.
REQUEST_TTL_HOURS=24
